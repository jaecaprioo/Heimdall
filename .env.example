# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# Used for OAuth redirect URIs and API endpoints.
APP_URL=""
APP_BASE_URL=""

# SUPABASE_URL: The URL of your Supabase project (Client-side)
VITE_SUPABASE_URL=""

# SUPABASE_ANON_KEY: The public/anon API key of your Supabase project (Client-side)
VITE_SUPABASE_ANON_KEY=""

# =========================================================================
# HEIMDALL OFFICIAL SOCIAL PLATFORM OAUTH CREDENTIALS (SERVER-SIDE ONLY)
# =========================================================================

# 1. Instagram / Meta Graph API (Instagram for Business / Creators)
# Obtain from: https://developers.facebook.com/apps/
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""

# 2. YouTube / Google Cloud OAuth 2.0
# Obtain from: https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# 3. TikTok for Developers API (Login Kit & Display API v2)
# Obtain from: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# 4. X (Twitter API v2 OAuth 2.0 with PKCE)
# Obtain from: https://developer.x.com/en/portal/dashboard
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# 5. Facebook Pages API (Meta Graph API v19.0)
# Obtain from: https://developers.facebook.com/apps/
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# 6. LinkedIn REST APIs & OpenID Connect
# Obtain from: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
